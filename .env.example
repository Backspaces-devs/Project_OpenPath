# ---------------------------------------------------------------------------
# OpenPath · Backspaces — environment
#
# Copy to `.env.local` and fill in only what you have. EVERY variable below is
# optional: with an empty file the app still runs, reading live data straight
# from the GitHub API (60 requests/hour per IP, no token needed).
#
#   cp .env.example .env.local
#
# Free tiers only — nothing here costs money.
# ---------------------------------------------------------------------------

# --- Supabase (optional) ----------------------------------------------------
# Create a free project at https://supabase.com/dashboard → Project Settings → API.
# With these two set, /discover reads from the `repositories` table instead of
# calling the GitHub Search API on every request.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row level security, so it is used exclusively by the
# scripts in /scripts and by the GitHub Action cron jobs. NEVER expose it to the
# browser and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (optional but recommended) --------------------------------------
# One or more Personal Access Tokens, comma separated, used round-robin.
#   github.com → Settings → Developer settings → Personal access tokens → Tokens (classic)
#   Scope needed: `public_repo` (read public repositories). No other scope.
# One token raises the limit from 60 to 5,000 requests/hour. Add several to
# multiply that; OpenPath rotates automatically when one runs dry.
GITHUB_TOKEN_POOL=

# Convenience fallback if you only have a single token.
GITHUB_TOKEN=

# Override if you point at GitHub Enterprise.
# GITHUB_API_BASE_URL=https://api.github.com

# --- Phase 4 only ------------------------------------------------------------
# Embeddings for semantic search. Not needed for anything in Phase 1–3.
OPENAI_API_KEY=

# --- Misc -------------------------------------------------------------------
# Canonical origin, used in metadata and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
